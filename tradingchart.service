[Unit]
Description=Chartivia - charting & trading platform (Node, port 8088)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/TradingChart
ExecStart=/usr/local/bin/node --max-old-space-size=256 server/index.js
Restart=always
RestartSec=3
Environment=NODE_ENV=production
Environment=PORT=8088
EnvironmentFile=-/root/TradingChart/server/data/env
# Resource guard: never let this service starve the VPN / AI services
MemoryHigh=300M
MemoryMax=420M
CPUWeight=80
TasksMax=200
# Filesystem / privilege hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/root/TradingChart/server/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
