{
  "baseBranch": "sdd/retrofit",
  "agent": {
    "implementer": "hermes chat --oneshot --yolo -Q -m ag/gemini-3.8-flash-high --reasoning ultra --query-file {PROMPT_FILE}",
    "testAuthor": "hermes chat --oneshot --yolo -Q -m ag/gemini-3.8-flash-high --reasoning ultra --query-file {PROMPT_FILE}",
    "reviewer": "hermes chat --oneshot --yolo -Q -m ag/gemini-3.8-flash-high --reasoning high --query-file {PROMPT_FILE}",
    "timeoutSec": 3600,
    "recon": "hermes chat --oneshot --yolo -Q -m ag/gemini-3.8-flash-high --reasoning high --query-file {PROMPT_FILE}",
    "docs": "hermes chat --oneshot --yolo -Q -m ag/gemini-3.8-flash-high --reasoning ultra --query-file {PROMPT_FILE}"
  },
  "maxAttempts": 3,
  "acceptanceDir": "tests/acceptance",
  "build": "./node_modules/.bin/vite build",
  "test": "node tests/validate-all-indicators.js",
  "acceptanceRun": "flock /run/lock/tc-qa.lock timeout 1500 node {FILE}",
  "failureMarkers": [
    "❌",
    "re:Failed: [1-9]",
    "re:[1-9]\\d* defects across"
  ],
  "regression": "bash scripts/qa/run_regression.sh .sdd/out/regression qa_accounts_cycle1 qa_accounts_cycle3 qa_cycleA qa_i18n_final && ! grep -l '❌' .sdd/out/regression/*.log",
  "protected": [
    "**/*.key",
    "**/.env",
    ".sdd/**",
    ".sdd/worktrees/**",
    ".specify/**",
    "scripts/qa/**",
    "scripts/sdd/**",
    "server/data/**",
    "specs/**",
    "tests/acceptance/**"
  ],
  "alwaysAllowed": [
    "package-lock.json"
  ],
  "highRisk": [
    "server/accounts.js",
    "server/adminAuth.js",
    "server/adminApi.js",
    "server/security.js",
    "server/featuresCatalog.js",
    "server/tradeRelay.js",
    "server/tradeRelayApi.js",
    "client/src/authManager.js"
  ],
  "uiProbe": {
    "enabled": true,
    "baseUrl": "http://127.0.0.1:8088",
    "pages": [
      "/",
      "/chart"
    ],
    "viewports": [
      {
        "name": "desktop",
        "width": 1440,
        "height": 900
      },
      {
        "name": "mobile",
        "width": 390,
        "height": 844,
        "mobile": true
      }
    ],
    "locales": [
      {
        "name": "en",
        "setup": "(()=>{const k='tradingchart_user_settings';const s=JSON.parse(localStorage.getItem(k)||'{}');if(s.language!=='en'){s.language='en';localStorage.setItem(k,JSON.stringify(s));location.reload();}})()"
      },
      {
        "name": "fa",
        "setup": "(()=>{const k='tradingchart_user_settings';const s=JSON.parse(localStorage.getItem(k)||'{}');if(s.language!=='fa'){s.language='fa';localStorage.setItem(k,JSON.stringify(s));location.reload();}})()"
      }
    ],
    "minTouchTarget": 44,
    "interactiveSelector": "button, a[href], input, select, textarea, [role=button]",
    "untranslatedPattern": "",
    "chromePath": "/usr/bin/chromium"
  },
  "worktreeSetup": "ln -s /root/TradingChart/node_modules node_modules && mkdir -p server/data && cp -r /root/TradingChart/server/data/. server/data/ 2>/dev/null; true",
  "serve": "./node_modules/.bin/vite build >/dev/null && PORT=$SDD_PORT node server/index.js",
  "servePort": 18088,
  "serveReadyPath": "/",
  "serveTimeoutSec": 120,
  "parallel": true,
  "hooks": {
    "before_implement": [],
    "after_implement": []
  },
  "reconMaxLines": 220
}
